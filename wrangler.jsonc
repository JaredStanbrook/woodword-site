{
  // =====================================================================
  // Deployed from the Cloudflare dashboard — no terminal required.
  //
  // Ask Claude to fill this in (it runs `npm run configure`), or edit by
  // hand. Find whatever is still unset:
  //   grep -in "change.me\|0000000" wrangler.jsonc
  //
  // Full walkthrough: docs/deploy.md
  // =====================================================================
  "$schema": "node_modules/wrangler/config-schema.json",

  // CHANGE_ME — the Worker script name. This is the identity Cloudflare
  // stores secrets, routes and deployments against, so renaming it later
  // creates a *new* worker and orphans the old one's secrets.
  "name": "mooihout",

  "compatibility_date": "2025-01-01",
  "main": "worker/index.ts",

  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    // This app server-renders every page, so unmatched paths are handled
    // by the worker's own notFound, not by an SPA shell. "none" keeps the
    // asset layer from swallowing 404s that should reach your router.
    "not_found_handling": "none",
    // With ACCESS_GATE on, files in public/ (images, media, og.png) are still
    // served straight from Cloudflare without running the worker, so anyone
    // with the URL can fetch them. To gate them too, uncomment this: every
    // request then runs the worker first, except the bundle, fonts and
    // favicon the locked page needs. It costs a worker request per file, so
    // leave it off unless public/ holds something private. Keep it in step
    // with OPEN_PREFIXES in worker/middleware/access-gate.middleware.ts.
    // "run_worker_first": ["/*", "!/static/*", "!/fonts/*", "!/favicon.svg"],
  },

  "observability": {
    "enabled": true,
  },

  // A new id on every deploy, read at runtime. Layout.tsx appends it to
  // /static/main.css, which is what makes the year-long cache in
  // public/_headers safe: each deploy asks for a new URL. (A Vite `define`
  // cannot do this — `wrangler deploy` bundles worker/ itself.)
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },

  "dev": {
    "port": 3000,
    "local_protocol": "http",
  },

  // ---------------------------------------------------------------------
  // Everything below is production. Cloudflare builds and deploys this on
  // every push once the repo is connected under Settings -> Builds.
  //
  // Adding a staging environment later means adding an "env": { "staging":
  // {...} } block — but named environments INHERIT NOTHING, so every binding
  // and var must be repeated inside it, and it deploys a SEPARATE worker with
  // its own secrets. See the appendix in docs/deploy.md.
  // ---------------------------------------------------------------------

  // CHANGE_ME — delete this block to publish on <name>.<subdomain>.workers.dev
  // instead. `zone_name` is only required when the record is ambiguous;
  // a custom_domain on a zone in the same account resolves without it.
  "routes": [
    {
      "pattern": "mooihout.stanbrook.me",
      "custom_domain": true,
    },
  ],

  // CHANGE_ME — Dashboard: Storage & Databases -> D1 -> Create.
  //             The Database ID is on the database's overview page.
  // The D1 and KV ids below, and the domain in `routes`, RP_ID and ORIGIN,
  // belong to the template's own demo deployment.
  // A site made from the template must replace them (`npm run configure`
  // does), or it shares the demo's database and sessions.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mooihout-db",
      "database_id": "2ac578bd-b3a9-4744-a591-8cda44d3cca7",
      "migrations_dir": "drizzle",
    },
  ],

  // CHANGE_ME — Dashboard: Storage & Databases -> KV -> Create Instance.
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "b429ff1efff1488d85c5ed66533ba75d",
    },
  ],

  // CHANGE_ME — Dashboard: R2 -> Create bucket.
  // Optional: delete this block and `R2` in worker/types.ts if the site
  // stores no files.
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "mooihout-files",
    },
  ],

  // Edge rate limiting. `namespace_id` is an arbitrary number you pick per
  // limiter within this worker — it is NOT a resource to provision, so
  // nothing here needs changing. Used by the auth API to throttle login
  // attempts by IP before they reach the database.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60,
      },
    },
  ],

  "vars": {
    "ENVIRONMENT": "production",

    // --- ACCESS GATE ---
    // Lock the site to invited visitors while it is not public yet. Admins
    // make and revoke links at /admin/access; a signed-in admin sees all.
    //   "off"      open to everyone.
    //   "session"  each link works once and then belongs to one browser.
    //   "link"     a link keeps working, in any browser, until it expires.
    "ACCESS_GATE": "off",
    // Which paths the gate guards, comma separated: "/reports,/beta" locks
    // those sections and leaves the rest of the site public. Empty: all of it.
    // An opened link lands on the first one.
    "ACCESS_GATE_PATHS": "",

    // --- COOKIES ---
    // The optional cookie categories this site uses, comma separated, from
    // "functional,performance,targeting". Visitors get a banner to accept or
    // reject them, and switches for each. List only what the site really
    // sets (worker/config/cookies.config.ts lists every cookie). Empty: only
    // strictly necessary cookies, which need no consent, and no banner.
    "COOKIE_CATEGORIES": "performance",

    // --- BRANDING ---
    // CHANGE_ME — how the site names itself in the title, nav and footer.
    "APP_NAME": "Mooihout",
    "APP_TAGLINE": "Handmade furniture, made to your measurements. Turn it, resize it, see the price, and we build exactly that.",
    "APP_LOCALE": "en-IE",
    "APP_CURRENCY": "EUR",
    // IANA zone, e.g. "Australia/Perth". Decides what "today" means when a
    // page asks (`today(c.var.app.timezone)` in worker/lib/dates.ts). UTC is
    // right for storage and wrong for "what's due today" in Perth before 8am.
    "APP_TIMEZONE": "UTC",
    // Default link-preview image for pages that set none, e.g. "/og.png"
    // (1200×630, in public/). Empty means none. Generate one from the site's
    // own name and colours with `node scripts/og-image.mjs`.
    "APP_OG_IMAGE": "/og.png",

    // --- CORE AUTH ---
    // Enabled methods: passkey, password, pin, totp, email, sms
    "AUTH_METHODS": "password,passkey,totp",

    // Milliseconds.
    "SESSION_DURATION": "86400000",
    "SESSION_RENEWAL_THRESHOLD": "3600000",
    "MAX_SESSIONS_PER_USER": "5",

    // SECONDS — not milliseconds. This sets the JWT `exp` claim and the
    // cookie Max-Age directly. Pasting a millisecond value here (86400000)
    // yields a ~2.7 YEAR session, not a day. 86400 = 24 hours.
    "JWT_EXPIRY": "86400",

    // --- SECURITY ---
    // JWT_SECRET is deliberately absent: it is a SECRET, not a var. Set it in
    // the dashboard under Settings -> Variables and Secrets, type "Secret".
    // Putting it here commits it to git and leaks it to anyone with repo
    // access. See docs/deploy.md.
    "MAX_FAILED_LOGIN_ATTEMPTS": "5",
    "LOCKOUT_DURATION": "900000",
    "REQUIRE_EMAIL_VERIFICATION": "false",
    "REQUIRE_PHONE_VERIFICATION": "false",
    // Comma-separated allowlist. Empty means open registration.
    // Set this for an invite-only or single-user site.
    "ALLOWED_EMAILS": "",

    // One-owner site: set to "true" and sign-up accepts only
    // BOOTSTRAP_ADMIN_EMAIL, and only while no account exists; after that
    // /register is gone for good. Needs BOOTSTRAP_ADMIN_EMAIL set, or nobody
    // can ever register. Leave "false" for sites with open sign-up.
    "SINGLE_ACCOUNT": "false",

    // First-run admin, so you never need a terminal to get one. Register
    // normally with this exact email and that account becomes an admin — but
    // ONLY while no admin exists yet, so it disarms itself the moment it
    // works. Safe to leave set; tidier to clear afterwards.
    "BOOTSTRAP_ADMIN_EMAIL": "Jared@stanbrook.me",

    // --- ROLES & PERMISSIONS ---
    // CHANGE_ME — model your own resources here. Convention:
    //   resource.action      → the action on rows the user owns
    //   resource.action.any  → the action on anyone's rows
    //   "*"                  → expands to all of PERMISSIONS_AVAILABLE
    // Keep the resource names in sync with the `Resource` type in
    // worker/services/access.service.ts.
    "ROLES_AVAILABLE": "user,admin",
    "ROLES_DEFAULT": "user",
    // Roles that cannot be self-assigned at registration. Get your first
    // admin with BOOTSTRAP_ADMIN_EMAIL below — no terminal needed.
    "ROLES_RESTRICTED": "admin",
    "PERMISSIONS_AVAILABLE": "products.read.any,products.create.any,products.update.any,products.delete.any,orders.read,orders.read.any,orders.update.any,designs.read,designs.create,designs.delete,designs.read.any,designs.delete.any,access.read,access.create,access.update",
    "ROLES_INHERENT": "user:orders.read,designs.read,designs.create,designs.delete;admin:*",

    // --- PASSKEY / WEBAUTHN ---
    // CHANGE_ME — these MUST match the deployed domain or passkeys fail
    // with no useful error. RP_ID is the bare hostname (no scheme, no
    // port); ORIGIN is the full origin users load the site from.
    "RP_NAME": "Mooihout",
    "RP_ID": "mooihout.stanbrook.me",
    "ORIGIN": "https://mooihout.stanbrook.me",

    // --- PASSWORD CONFIG ---
    // These are enforced on registration, password change and reset. They used
    // to be read into config and checked nowhere, so the values here made no
    // difference to anything.
    //
    // Length over composition, per NIST SP 800-63B. Requiring an uppercase, a
    // digit and a symbol adds little entropy and reliably produces
    // "Password1!", while pushing people towards reuse and sticky notes; a
    // longer minimum is worth more than all four rules together. Set any of
    // them to "true" if a compliance checklist demands it.
    "PASSWORD_MIN_LENGTH": "12",
    "PASSWORD_REQUIRE_UPPERCASE": "false",
    "PASSWORD_REQUIRE_LOWERCASE": "false",
    "PASSWORD_REQUIRE_NUMBERS": "false",
    "PASSWORD_REQUIRE_SPECIAL": "false",

    // PBKDF2 rounds for new password hashes. 100000 is the MAXIMUM: Workers'
    // WebCrypto refuses anything higher, and every sign-in then fails with
    // "iteration counts above 100000 are not supported". Higher values are
    // clamped to it. Each hash records its own cost, so lowering this never
    // breaks existing passwords. See worker/lib/crypto.ts.
    "PASSWORD_HASH_ITERATIONS": "100000",

    // --- PIN CONFIG ---
    "PIN_LENGTH": "6",
    "PIN_NUMBERS_ONLY": "true",

    // --- TOTP CONFIG ---
    // TOTP_ISSUER is the name shown in the user's authenticator app.
    "TOTP_ISSUER": "Mooihout",
    "TOTP_ALGORITHM": "SHA1",
    "TOTP_DIGITS": "6",
    "TOTP_PERIOD": "30",

    // --- SHOP ---
    // Secrets (Settings -> Variables and Secrets, type Secret), all optional:
    //   STRIPE_SECRET_KEY      takes payment. Without it a production site
    //                          refuses orders; a non-production one simulates.
    //   STRIPE_WEBHOOK_SECRET  the signing secret of the webhook pointed at
    //                          https://<domain>/api/stripe/webhook
    //   ANTHROPIC_API_KEY      AI-assisted product creation in the admin
    //   RESEND_API_KEY         order confirmation emails
    // Claude model for product generation.
    "AI_MODEL": "claude-opus-5-5",
    // Sender for order emails, e.g. "Mooihout <orders@your-domain>". Needs
    // RESEND_API_KEY and a domain verified with Resend.
    "EMAIL_FROM": "",
    // Where a "new paid order" email goes. Empty: none.
    "ORDERS_EMAIL": "",
  },
}
